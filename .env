# StorySprout AI - Local Environment Configuration
SECRET_KEY=dev-secret-key-childrens-story-2025
FLASK_ENV=development
DEBUG=True
PORT=5000

# Story Generation LLM Providers (Optional - built-in story engine runs offline without keys)
GEMINI_API_KEY=
OPENAI_API_KEY=

# Image Generation Providers (Optional - Pollinations AI is free tier, no key required)
POLLINATIONS_ENABLED=true
HF_TOKEN=

# Text-To-Speech Configuration ('gtts' generates MP3 files, 'browser' uses Web Speech API)
TTS_PROVIDER=gtts

# File Upload Constraints
MAX_CONTENT_LENGTH_MB=5
ALLOWED_EXTENSIONS=png,jpg,jpeg,webp
