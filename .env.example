# Flask Application Secret Key (generate a secure random string in production)
SECRET_KEY=change-this-to-a-secure-random-key-in-production

# Flask Environment (development / production)
FLASK_ENV=development
DEBUG=True
PORT=5000

# Story Generation LLM Providers (Optional - application runs offline/template mode without keys)
# 1. Google Gemini API Key (optional)
# Get from: https://aistudio.google.com/
GEMINI_API_KEY=

# 2. OpenAI API Key (optional)
# Get from: https://platform.openai.com/
OPENAI_API_KEY=

# AI Image Generation Providers (Optional - manual image uploads are always supported)
# 1. Pollinations AI (Free tier, no key required - set to 'false' to disable)
POLLINATIONS_ENABLED=true

# 2. Hugging Face Inference Token (optional)
# Get from: https://huggingface.co/settings/tokens
HF_TOKEN=

# Text-To-Speech Configuration
# Options: 'gtts' (free server-side audio generation), 'browser' (client Web Speech API)
TTS_PROVIDER=gtts

# File Upload Constraints
MAX_CONTENT_LENGTH_MB=5
ALLOWED_EXTENSIONS=png,jpg,jpeg,webp
